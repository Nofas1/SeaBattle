POSTGRES_DB=sea_battle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgres://postgres:replace-with-a-strong-local-password@postgres:5432/sea_battle?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes

# Either provide these directly or use the credentials.json mount in compose.yaml.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=./credentials.json
GOOGLE_REDIRECT_URL=http://127.0.0.1:28080/auth/google/callback
FRONTEND_URL=http://127.0.0.1:8080
IS_PROD=false
